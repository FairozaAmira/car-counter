APP_NAME=AIPS Traffic Counter
APP_VERSION=1.0.0
LOG_LEVEL=INFO
BATCH_CONCURRENCY=8
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_REQUEST_TOPIC=traffic.analysis.requests
KAFKA_RESULT_TOPIC=traffic.analysis.results
KAFKA_CONSUMER_GROUP=traffic-analysis-workers
KAFKA_REQUEST_TIMEOUT_MS=120000
KAFKA_CONSUMER_POLL_TIMEOUT_MS=1000
KAFKA_CONSUMER_MAX_RECORDS=100
