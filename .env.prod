ENVIRONMENT=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=4
APP_RELOAD=false
KEEP_ALIVE_TIMEOUT_SECONDS=5
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
CORS_ORIGINS=https://example.com
API_KEY=<set-by-secret-manager>
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=<set-by-secret-manager>
