APP_NAME=AIPS Traffic Counter
APP_VERSION=1.0.0
ENVIRONMENT=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
APP_RELOAD=false
KEEP_ALIVE_TIMEOUT_SECONDS=5
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
BATCH_CONCURRENCY=8
CORS_ORIGINS=http://localhost:3000
TRUSTED_PROXY_HOSTS=
API_KEY=
UPLOAD_MAX_BYTES=1048576
UPLOAD_ALLOWED_EXTENSIONS=.txt
UPLOAD_ALLOWED_MIME_TYPES=text/plain,application/octet-stream
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_UPLOAD_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_OPEN=true
DATABASE_URL=postgresql+asyncpg://application:application-local@localhost:5433/application
POSTGRES_PORT=5433
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_COMMAND_TIMEOUT_SECONDS=30
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_REQUEST_TOPIC=traffic.analysis.requests
KAFKA_RESULT_TOPIC=traffic.analysis.results
KAFKA_CONSUMER_GROUP=traffic-analysis-workers
KAFKA_REQUEST_TIMEOUT_MS=120000
KAFKA_CONSUMER_POLL_TIMEOUT_MS=1000
KAFKA_CONSUMER_MAX_RECORDS=100
